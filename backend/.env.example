# --- Deployment configuration ---
# OpenAI API key. Backend only — never expose this to the frontend or any NEXT_PUBLIC_ variable.
# Leave empty to run the deterministic local analyzer instead of calling OpenAI.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5-mini when unset.
OPENAI_MODEL=
# The exact browser origin allowed to call this API, e.g. https://app.example.com
CORS_ORIGIN=

# --- Local development only ---
# Application environment: development, test, or production.
HUMAN_LAYER_ENV=development
# Host interface used by the local Uvicorn server.
HUMAN_LAYER_HOST=127.0.0.1
# Port used by the local Uvicorn server.
HUMAN_LAYER_PORT=8000
